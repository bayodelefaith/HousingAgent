{
    "version": 2,
    "builds": [
        {
            "src": "app/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/vite"
        }
    ],
    "routes": [
        {
            "src": "/uploads/(.*)",
            "dest": "/app/main.py"
        },
        {
            "src": "/api/(.*)",
            "dest": "/app/main.py"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ]
}